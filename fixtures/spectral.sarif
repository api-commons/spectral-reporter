                "level": "note"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "channel-no-empty-parameter",
              "name": "channel-no-empty-parameter",
              "shortDescription": {
                "text": "Channel path must not have empty parameter substitution pattern."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
