{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Spectral",
          "informationUri": "https://github.com/stoplightio/spectral",
          "rules": [
            {
              "id": "operation-operationId",
              "name": "operation-operationId",
              "shortDescription": {
                "text": "Operation must have \"operationId\"."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "operation-4xx-response",
              "name": "operation-4xx-response",
              "shortDescription": {
                "text": "Operation must have at least one 4xx response."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "operation-description",
              "name": "operation-description",
              "shortDescription": {
                "text": "Operation \"description\" must be present and non-empty string."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "operation-tag-defined",
              "name": "operation-tag-defined",
              "shortDescription": {
                "text": "Operation tags must be defined in global tags."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "info-contact",
              "name": "info-contact",
              "shortDescription": {
                "text": "Info object must have \"contact\" object."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "info-license",
              "name": "info-license",
              "shortDescription": {
                "text": "Info object must have \"license\" object."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "oas3-unused-component",
              "name": "oas3-unused-component",
              "shortDescription": {
                "text": "Potentially unused component has been detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "owasp:api2:2023-no-api-keys-in-url",
              "name": "owasp:api2:2023-no-api-keys-in-url",
              "shortDescription": {
                "text": "API keys must not be passed in the URL query string."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "owasp:api8:2023-define-error-responses-500",
              "name": "owasp:api8:2023-define-error-responses-500",
              "shortDescription": {
                "text": "Operation is missing a \"500\" error response."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "operation-operationId-unique",
              "name": "operation-operationId-unique",
              "shortDescription": {
                "text": "Every operation must have a unique \"operationId\"."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "no-$ref-siblings",
              "name": "no-$ref-siblings",
              "shortDescription": {
                "text": "$ref must not be placed next to any other properties."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://docs.stoplight.io/docs/spectral/"
            },
            {
              "id": "operation-success-response",
